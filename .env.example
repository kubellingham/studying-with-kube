# Copy this file to .env.local and fill it in. .env.local is git-ignored.

# Which AI provider the server uses: openrouter (default) or aimlapi.
KUBE_PROVIDER=

# --- OpenRouter (used when KUBE_PROVIDER is openrouter or unset) ---
# Create a key at https://openrouter.ai/keys
# Tip: give the key a credit limit in OpenRouter (e.g. $5) as a hard spending cap.
OPENROUTER_API_KEY=
# Optional. Any OpenRouter model ID. Default: anthropic/claude-haiku-5.5
# Paid-tier candidate: anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=
# Optional. How hard the model thinks: low | medium | high | off. Default: low
OPENROUTER_REASONING_EFFORT=

# --- AI/ML API (used when KUBE_PROVIDER is aimlapi) ---
# Create a key at https://aimlapi.com/app/keys (prepaid balance)
AIMLAPI_API_KEY=
# Optional. Any AI/ML API chat model ID. Default: anthropic/claude-haiku-5.5
# Paid-tier candidate: anthropic/claude-sonnet-5.5
AIMLAPI_MODEL=
# Optional. low | medium | high | off. Default: low
AIMLAPI_REASONING_EFFORT=

# Optional. Shared password for the whole site. Leave unset locally (no password).
# On Vercel, set it in the project's environment variables instead.
KUBE_ACCESS_PASSWORD=

# Optional cost guards (defaults shown).
KUBE_LIMIT_PER_IP_PER_HOUR=10
KUBE_LIMIT_PER_DAY=50
KUBE_MAX_CONCURRENT=3
