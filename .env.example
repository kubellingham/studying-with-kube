# Copy this file to .env.local and fill in the key. .env.local is git-ignored.

# Required. Create a key at https://openrouter.ai/keys
# Tip: give the key a credit limit in OpenRouter (e.g. $5) as a hard spending cap.
OPENROUTER_API_KEY=

# Optional. Shared password for the whole site. Leave unset locally (no password).
# On Vercel, set it in the project's environment variables instead.
KUBE_ACCESS_PASSWORD=

# Optional. Any OpenRouter model id. Default: anthropic/claude-sonnet-5.5
# Much cheaper option to compare against: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Optional. How hard the model thinks: low | medium | high | off. Default: low
OPENROUTER_REASONING_EFFORT=

# Optional cost guards (defaults shown).
KUBE_LIMIT_PER_IP_PER_HOUR=10
KUBE_LIMIT_PER_DAY=50
KUBE_MAX_CONCURRENT=3
